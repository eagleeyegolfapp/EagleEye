# Copy to .env and fill in. Never commit .env.
#
# Only LATE_API_KEY is required locally. The runner fills account IDs.
# For posts that still go out when this Mac is off, also add LATE_API_KEY as
# a GitHub Actions secret on eagleeyegolfapp/EagleEye.

# Late — https://getlate.dev  → Settings → API
LATE_API_KEY=
LATE_PROFILE_ID=
LATE_TWITTER_ACCOUNT_ID=
LATE_INSTAGRAM_ACCOUNT_ID=
LATE_REDDIT_ACCOUNT_ID=

# xAI — https://console.x.ai  (Grok copy + Imagine stills)
XAI_API_KEY=

# Optional: if Imagine is called from this Mac instead of Grok TUI
XAI_IMAGE_MODEL=grok-imagine-image
XAI_TEXT_MODEL=grok-4

# Email reports (Gmail app password, not your login password)
REPORT_EMAIL=eagleeyegolfapp@gmail.com
GMAIL_USER=eagleeyegolfapp@gmail.com
GMAIL_APP_PASSWORD=
